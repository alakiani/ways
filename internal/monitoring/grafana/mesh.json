{
  "uid": "ways-mesh",
  "title": "Mesh",
  "description": "Nodes, every Link with its latency, loss, transport, instances and throughput, active Paths and their weights, and the Bridges in the Bridge Address (ADR 0006, ADR 0011).",
  "tags": ["ways"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Nodes",
      "description": "1 when Prometheus scrapes the Node's Agent.",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "ways-prometheus" },
      "targets": [{ "refId": "A", "expr": "up{job=\"agents\"}", "legendFormat": "{{node}}" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": { "0": { "text": "down", "color": "red" }, "1": { "text": "up", "color": "green" } } }],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Bridge Address",
      "description": "The Bridges its record holds.",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "ways-prometheus" },
      "targets": [{ "refId": "A", "expr": "ways_bridge_address_member == 1", "format": "table", "instant": true }],
      "transformations": [{ "id": "organize", "options": { "excludeByName": { "Time": true, "Value": true, "__name__": true, "instance": true, "job": true } } }]
    },
    {
      "id": 3,
      "type": "table",
      "title": "Links",
      "description": "Every Link: up as either end sees it, round-trip time, loss and the transport in use.",
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "ways-prometheus" },
      "targets": [
        { "refId": "A", "expr": "max by (link) (ways_link_up)", "format": "table", "instant": true },
        { "refId": "B", "expr": "max by (link) (ways_link_rtt_seconds)", "format": "table", "instant": true },
        { "refId": "C", "expr": "max by (link) (ways_link_loss_ratio)", "format": "table", "instant": true },
        { "refId": "D", "expr": "max by (link, transport) (ways_link_transport)", "format": "table", "instant": true }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": { "excludeByName": { "Time": true, "Value #D": true },
          "renameByName": { "Value #A": "up", "Value #B": "rtt (s)", "Value #C": "loss" } } }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Link latency",
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "ways-prometheus" },
      "targets": [{ "refId": "A", "expr": "max by (link) (ways_link_rtt_seconds)", "legendFormat": "{{link}}" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Link loss",
      "gridPos": { "x": 12, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "ways-prometheus" },
      "targets": [{ "refId": "A", "expr": "max by (link) (ways_link_loss_ratio)", "legendFormat": "{{link}}" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1 } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Active Paths",
      "description": "Buckets per candidate per Bridge per Rule (64 per Rule, ADR 0008).",
      "gridPos": { "x": 0, "y": 21, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "ways-prometheus" },
      "targets": [{ "refId": "A", "expr": "ways_path_buckets > 0", "legendFormat": "{{node}} {{rule}} → {{candidate}}" }],
      "fieldConfig": { "defaults": { "custom": { "stacking": { "mode": "normal" } }, "max": 64 } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Bucket moves",
      "description": "Moves by kind; Path flapping counts failure moves only.",
      "gridPos": { "x": 12, "y": 21, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "ways-prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (node, kind) (increase(ways_path_moves_total[1h]))", "legendFormat": "{{node}} {{kind}}" }]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Bridge eligibility",
      "description": "Each domestic Bridge as the probe Device sees it.",
      "gridPos": { "x": 0, "y": 29, "w": 24, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "ways-prometheus" },
      "targets": [{ "refId": "A", "expr": "ways_bridge_eligible", "legendFormat": "{{node}}" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": { "0": { "text": "ineligible", "color": "red" }, "1": { "text": "eligible", "color": "green" } } }],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Path weights: $bridge",
      "description": "Each candidate's weight per Rule: throughput × availability² × RTT factor (ADR 0008). A candidate under 25% of the best weight is cut off and gets no buckets; it is drawn dashed.",
      "repeat": "bridge",
      "repeatDirection": "h",
      "maxPerRow": 2,
      "gridPos": { "x": 0, "y": 34, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "ways-prometheus" },
      "targets": [
        { "refId": "A", "expr": "ways_path_weight{node=~\"$bridge\"} unless on (node, rule_id, candidate) ways_path_cut_off == 1", "legendFormat": "{{rule}} → {{candidate}}" },
        { "refId": "B", "expr": "ways_path_weight{node=~\"$bridge\"} and on (node, rule_id, candidate) ways_path_cut_off == 1", "legendFormat": "{{rule}} → {{candidate}} (cut off)" }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [{ "matcher": { "id": "byFrameRefID", "options": "B" }, "properties": [{ "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } }] }]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] } }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Throughput by Link",
      "description": "What each Link's far end can still send the Bridge measuring it: the last throughput test, raised by peaks of real traffic, with its age and the transport that carried it (ADR 0008).",
      "gridPos": { "x": 0, "y": 42, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "ways-prometheus" },
      "targets": [
        { "refId": "A", "expr": "max by (node, link) (ways_link_throughput_mbps)", "format": "table", "instant": true },
        { "refId": "B", "expr": "max by (node, link) (time() - ways_link_throughput_measured_timestamp_seconds)", "format": "table", "instant": true },
        { "refId": "C", "expr": "max by (node, link, transport) (ways_link_throughput_transport)", "format": "table", "instant": true }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": { "excludeByName": { "Time": true, "Value #C": true },
          "renameByName": { "node": "measured by", "Value #A": "Mbit/s", "Value #B": "age" } } }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [{ "matcher": { "id": "byName", "options": "age" }, "properties": [{ "id": "unit", "value": "s" }] }]
      }
    },
    {
      "id": 11,
      "type": "state-timeline",
      "title": "Instances Up: $link",
      "description": "Each Transport instance of the Link as either end sees it. Every instance down together is a blackout of the whole path, not one transport failing.",
      "repeat": "link",
      "repeatDirection": "h",
      "maxPerRow": 2,
      "gridPos": { "x": 0, "y": 50, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "ways-prometheus" },
      "targets": [{ "refId": "A", "expr": "ways_link_instance_up{link=~\"$link\"}", "legendFormat": "{{node}}: {{transport}} {{instance_id}}" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": { "0": { "text": "down", "color": "red" }, "1": { "text": "up", "color": "green" } } }],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "options": { "showValue": "never", "mergeValues": true }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "bridge",
        "label": "Bridge",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "ways-prometheus" },
        "definition": "label_values(ways_path_weight, node)",
        "query": { "query": "label_values(ways_path_weight, node)", "refId": "bridge" },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "link",
        "label": "Link",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "ways-prometheus" },
        "definition": "label_values(ways_link_instance_up, link)",
        "query": { "query": "label_values(ways_link_instance_up, link)", "refId": "link" },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  }
}
