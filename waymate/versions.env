# The upstream software a WAYMATE release bundles, pinned with checksums.
# Sourced by waymate/scripts/build-release.sh; the playbook reads the copy
# inside the release. All builds are linux/amd64.

# Synapse, the Matrix homeserver. The .deb comes from packages.matrix.org and
# is built per Ubuntu release: resolute is 26.04. The checksum is the SHA256
# in that suite's Packages index.
SYNAPSE=1.165.0
SYNAPSE_DEB=1.165.0+resolute1
SYNAPSE_SHA256=c378465b6c87650cf5b7099a7cc89fa9a9176cc70fa03274cffa8299e80721e2

# Matrix Authentication Service: sign-in, sessions, and the link to WAYS.
MAS=1.29.0
MAS_SHA256=d233fd948f144514c67b5c862e4665eb8de5e4deee6b7fd6ea7ea4ca11e02f93

# LiveKit, the media server calls run through.
LIVEKIT=1.13.11
LIVEKIT_SHA256=1e9ee90ca301e1842b2887fc77cb122759756a9c8aeb4334ee91de3325ec43fb

# The MatrixRTC authorization service, which lets a Matrix user into LiveKit.
LK_JWT=0.10.0
LK_JWT_SHA256=18bcd27802395900c3659c968a4af4baf5c7fe77444e1be2e7089228ee365432

# Element Web, the browser client. Element Call is built into it.
ELEMENT_WEB=1.12.35
ELEMENT_WEB_SHA256=5aaff32e348eba976aea8da11cd50f9ca7f824f235aa66e24d1176f829e6bba5
