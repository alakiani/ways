# Managed by waymate.yml. The MatrixRTC authorization service: it gives a
# signed-in Matrix user a LiveKit token for the call in their room.
LIVEKIT_URL=wss://{{ waymate_domain }}/livekit/sfu
LIVEKIT_KEY=waymate
LIVEKIT_SECRET={{ waymate_secrets['livekit-secret'] }}
LIVEKIT_JWT_BIND=127.0.0.1:{{ waymate_lk_jwt_port }}
LIVEKIT_FULL_ACCESS_HOMESERVERS={{ waymate_server_name }}
LIVEKIT_AS_REGISTRATION_FILE=/etc/waymate/rtc/lk-jwt-registration.yaml
LIVEKIT_HS_SERVER_NAME={{ waymate_server_name }}
LIVEKIT_CS_API_URL_OVERRIDES={{ waymate_server_name }}=http://127.0.0.1:{{ waymate_synapse_port }}
LIVEKIT_SANITY_CHECK_INTERVAL_SECONDS=60
