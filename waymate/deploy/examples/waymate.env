# Copy to ~/.waymate/waymate.env and fill in. waymate/scripts/waymate-ansible
# loads it before every playbook run. Keep it private: mode 600.

# The hostname WAYMATE is served on. It is also the Matrix server name, the
# part after the colon in every user ID, and that can never change once the
# VM has started for the first time.
WAYMATE_DOMAIN=chat.wayfinder.ir

# A public certificate for that hostname, and its key, on this laptop.
#   acme.sh --issue --server letsencrypt --dns dns_arvan -d chat.wayfinder.ir
#   acme.sh --install-cert -d chat.wayfinder.ir \
#     --fullchain-file ~/.waymate/tls/chat.wayfinder.ir.crt --key-file ~/.waymate/tls/chat.wayfinder.ir.key
WAYMATE_TLS_CERT_FILE=/Users/you/.waymate/tls/chat.wayfinder.ir.crt
WAYMATE_TLS_KEY_FILE=/Users/you/.waymate/tls/chat.wayfinder.ir.key

# Sign-in through WAYS: the Coordinator as an OpenID Provider. Leave the
# issuer empty until the Coordinator is one; WAYMATE then keeps its own
# passwords and you create the accounts (waymate/README.md).
WAYMATE_OIDC_ISSUER=
WAYMATE_OIDC_CLIENT_ID=waymate
WAYMATE_OIDC_CLIENT_SECRET=

# Only when the VM is behind NAT: the public address clients send call media
# to. The inventory address is used otherwise.
#WAYMATE_PUBLIC_IP=

# Only for a VM inside Iran that cannot reach the push gateway: the config of
# a WAYS Device issued for this VM. Synapse's outbound traffic then leaves
# through WAYS.
#WAYMATE_WAYS_DEVICE_CONF=/Users/you/.waymate/ways-device.conf
